# Defaults for scripts/setup.sh (Mac/Linux) and scripts/setup.ps1 (Windows).
# Each value is offered at the prompt: press Enter to keep it, or type another.
# Your answers are saved to deploy/config.local.env (not committed) and become the
# defaults the next time you run the script. Leave a value empty to have it worked out.

# Google account gcloud runs as. Empty: the account gcloud is signed in with.
ACCOUNT=
# Google Cloud project ID. Empty: the project gcloud is set to.
PROJECT_ID=
# Region for Cloud Run and the bucket.
REGION=us-central1
# Cloud Run service name.
SERVICE=patchlab
# Bucket for each user's labs. Empty: <project>-patchlab-labs. Bucket names are global.
BUCKET=
# Service account the app runs as. It gets access to the bucket and nothing else.
SERVICE_ACCOUNT=patchlab-run
# Who may sign in, comma-separated, such as alice@example.com,bob@example.com.
IAP_USERS=
# Size and cost limits for Cloud Run.
MEMORY=256Mi
MIN_INSTANCES=0
MAX_INSTANCES=1
CONCURRENCY=15
